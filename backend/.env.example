# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=release
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=30s

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# CockroachDB Configuration
DB_HOST=your-cluster.cockroachlabs.cloud
DB_PORT=26257
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=faangready
DB_SSL_MODE=verify-full
DB_SSL_ROOT_CERT=$HOME/.postgresql/root.crt

# Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h
BCRYPT_COST=12

# Judge0 Code Execution
# For local Docker (Linux only): http://localhost:2358
# For RapidAPI: https://judge0-ce.p.rapidapi.com
# Set JUDGE0_MOCK_MODE=true for local development without Judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=
JUDGE0_MOCK_MODE=false
JUDGE0_CPU_TIME_LIMIT=5.0
JUDGE0_WALL_TIME_LIMIT=10.0
JUDGE0_MEMORY_LIMIT=128000
JUDGE0_STACK_LIMIT=64000
JUDGE0_POLL_INTERVAL=500ms
JUDGE0_MAX_POLL_TIME=30s

# Razorpay Payment Gateway
# Get credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_GST_RATE=18.0

# Email Configuration
# Set EMAIL_ENABLED=true to enable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=hello@algopatterns.in
EMAIL_FROM_NAME=AlgoPatterns
EMAIL_ENABLED=false

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# AI Tutor Configuration
# Set AI_ENABLED=true to enable AI features
AI_ENABLED=false
AI_DEFAULT_PROVIDER=groq
AI_FALLBACK_PROVIDERS=deepseek,openai,nvidia

# Claude/Anthropic API (primary - Socratic teaching)
# For Azure Claude: use your Azure endpoint URL
# For Anthropic direct: https://api.anthropic.com/v1
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_BASE_URL=https://api.anthropic.com/v1

# DeepSeek API (fallback - best price/performance)
# Get API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq API (primary - GPT OSS 120B for Socratic teaching)
# Get API key from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA API (DeepSeek V4 Pro/Flash via NVIDIA)
# Get API key from https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

# OpenAI API (fallback)
# Get API key from https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding model for RAG (uses OpenAI API key)
EMBEDDING_MODEL=text-embedding-3-small

# AI Rate Limiting
AI_FREE_REQUESTS_PER_DAY=30
AI_MAX_CODE_LENGTH=50000
