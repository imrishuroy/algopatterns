NEXT_PUBLIC_API_URL=https://fangready-production.up.railway.app
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxx
NEXT_PUBLIC_SITE_URL=https://algopatterns.in

# Sentry (Error Tracking, Performance Monitoring, Session Replay)
# Get DSN from https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# Get Auth Token from https://sentry.io/settings/auth-tokens/

# Client-side (browser) - must be prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DEBUG=false

# Server-side (Node.js/Edge)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_DEBUG=false

# Build-time (for source maps upload)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=algo-patterns
SENTRY_PROJECT=algo-patterns-frontend

# PostHog (Product Analytics)
# Get your project token from https://posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
