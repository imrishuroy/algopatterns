  "cheatsheet": {
    "quickReference": [
      {
        "title": "Slice Operations",
        "code": "s = append(s, x)          // push\ns = s[:len(s)-1]          // pop\ntop := s[len(s)-1]        // peek\ns = append(s[:i], s[i+1:]...) // remove at i",
        "notes": "Slices are the foundation of most Go algorithm solutions"
      },
      {
        "title": "Map Operations",
        "code": "m := make(map[K]V)\nm[key] = value\nval, ok := m[key]         // check existence\ndelete(m, key)\nfor k, v := range m { }",
        "notes": "Use maps for O(1) lookups, counting, and sets"
      },
      {
        "title": "String Conversions",
        "code": "b := []byte(s)            // mutable bytes\nr := []rune(s)            // Unicode characters\ns := string(b)            // bytes to string\ns := strconv.Itoa(n)      // int to string\nn, _ := strconv.Atoi(s)   // string to int",
        "notes": "Remember: s[i] returns byte, not rune"
      },
      {
        "title": "Sorting",
        "code": "sort.Ints(nums)\nsort.Strings(strs)\nsort.Slice(s, func(i, j int) bool {\n    return s[i] < s[j]\n})",
        "notes": "sort.SliceStable for stable sorting"
      },
      {
        "title": "Binary Search",
        "code": "idx := sort.Search(len(s), func(i int) bool {\n    return s[i] >= target\n})\nfound := idx < len(s) && s[idx] == target",
        "notes": "Returns first index where condition is true"
      },
      {
        "title": "Heap (Priority Queue)",
        "code": "import \"container/heap\"\nheap.Init(&h)\nheap.Push(&h, x)\nmin := heap.Pop(&h).(int)",
        "notes": "Implement Len, Less, Swap, Push, Pop"
      }
    ],
    "commonPatterns": [
      {
        "title": "Two Sum Pattern",
        "code": "seen := make(map[int]int)\nfor i, n := range nums {\n    if j, ok := seen[target-n]; ok {\n        return []int{j, i}\n    }\n    seen[n] = i\n}"
      },
      {
        "title": "Two Pointers (Opposite)",
        "code": "left, right := 0, len(arr)-1\nfor left < right {\n    // process arr[left], arr[right]\n    left++\n    right--\n}"
      },
      {
        "title": "Sliding Window",
        "code": "left := 0\nfor right := 0; right < n; right++ {\n    // expand: add arr[right]\n    for /* need to shrink */ {\n        // shrink: remove arr[left]\n        left++\n    }\n    // update result\n}"
      },
      {
        "title": "BFS Template",
        "code": "queue := []T{start}\nvisited := map[T]bool{start: true}\nfor len(queue) > 0 {\n    curr := queue[0]\n    queue = queue[1:]\n    for _, next := range neighbors(curr) {\n        if !visited[next] {\n            visited[next] = true\n            queue = append(queue, next)\n        }\n    }\n}"
      },
      {
        "title": "DFS with Closure",
        "code": "var dfs func(node)\ndfs = func(node) {\n    if node == nil { return }\n    // process node\n    dfs(node.Left)\n    dfs(node.Right)\n}\ndfs(root)"
      },
      {
        "title": "Backtracking Template",
        "code": "var backtrack func(start int)\nbacktrack = func(start int) {\n    if /* goal reached */ {\n        result = append(result, append([]T{}, current...))\n        return\n    }\n    for i := start; i < n; i++ {\n        current = append(current, items[i])\n        backtrack(i + 1)\n        current = current[:len(current)-1]\n    }\n}\nbacktrack(0)"
      }
    ],
    "gotchas": [
      "Slices share underlying arrays: use append([]T{}, slice...) to copy",
      "Map iteration order is random: sort keys if order matters",
      "s[i] returns byte, not rune: use []rune(s) for Unicode",
      "Integer overflow in mid = (l+r)/2: use mid = l + (r-l)/2",
      "Nil map panics on write: always initialize with make()",
      "Modifying slice during range: iterate backwards or build new slice",
      "heap.Pop returns interface{}: cast with .(T)",
      "sort.Search returns len(s) if not found: check bounds"
    ]
  }
}